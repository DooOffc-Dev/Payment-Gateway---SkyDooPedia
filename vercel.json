{
  "builds": [
    {
      "src": "process.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/process",
      "dest": "process.py"
    },
    {
      "src": "/",
      "dest": "index.html"
    }
  ]
}
